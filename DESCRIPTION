Package: simweightR
Title: TCR Sequencing Data Preprocessing Via Similarity-Based Count Adjustment
Version: 0.1.0
Authors@R: c(
    person("Thomas", "Smits", email = "Thomas.Smits@Radboudumc.nl", role = c("aut", "cre"), comment = c(ORCID = "0000-0002-5486-9890")),
